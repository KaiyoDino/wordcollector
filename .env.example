# Optional: Merriam-Webster keys can also be entered in the app (Settings → Merriam-Webster API keys).
# Free keys from https://dictionaryapi.com/register/index
# Request the "Collegiate Dictionary" and "Collegiate Thesaurus" APIs.
# Copy this file to .env and fill in your own keys. Never commit .env.
MW_COLLEGIATE_KEY=
MW_THESAURUS_KEY=

# Optional
PORT=5173

# Optional: AI explanations in Compare (can also be set in Settings).
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Groq retires models now and then; override the default (openai/gpt-oss-120b) here if needed.
GROQ_MODEL=
# Paid alternative (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
