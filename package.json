{
  "name": "wordcollector",
  "productName": "Word Collector",
  "version": "1.0.0",
  "description": "A personal word library with automatic dictionary definitions.",
  "author": "KaiyoDino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiyoDino/wordcollector.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js --no-open",
    "desktop": "electron .",
    "dist": "node scripts/build.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kaiyodino.wordcollector",
    "productName": "Word Collector",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Word-Collector-Setup-${version}.${ext}",
      "shortcutName": "Word Collector",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KaiyoDino",
        "repo": "wordcollector",
        "releaseType": "release"
      }
    ]
  }
}
